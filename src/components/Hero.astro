---
import { whatsappUrl } from "../data/site";
---

<section class="relative isolate overflow-hidden bg-brand-ink">
  <picture aria-hidden="true">
    <source
      media="(min-width: 768px)"
      srcset="/image/generated/reforma-de-piscina-de-fibra-em-bh-960.webp 960w, /image/generated/reforma-de-piscina-de-fibra-em-bh-1280.webp 1280w, /image/generated/reforma-de-piscina-de-fibra-em-bh-1440.webp 1440w, /image/generated/reforma-de-piscina-de-fibra-em-bh-1600.webp 1600w"
      sizes="100vw"
    />
    <img
      class="absolute inset-0 h-full w-full object-cover"
      src="/image/generated/reforma-de-piscina-de-fibra-em-bh-M-640.webp"
      srcset="/image/generated/reforma-de-piscina-de-fibra-em-bh-M-640.webp 640w, /image/generated/reforma-de-piscina-de-fibra-em-bh-M-960.webp 960w"
      sizes="100vw"
      width="640"
      height="800"
      alt=""
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>
  <div class="absolute inset-0 bg-brand-ink/70 md:bg-brand-ink/65" aria-hidden="true"></div>

  <div class="relative container-site flex min-h-[650px] items-center py-20 md:min-h-[740px] md:py-28">
    <div class="mx-auto w-full min-w-0 max-w-4xl text-center text-white">
      <p class="eyebrow text-white/85">Casa e Piscina</p>
      <h1 class="mt-5 text-4xl font-black leading-tight md:text-7xl">
        Reforma de Piscina de Fibra
      </h1>
      <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-white/90 md:text-xl">
        Especialistas em Reforma, Pintura e Manutenção de Piscina de Fibra em Belo Horizonte e Região Metropolitana.
      </p>
      <a class="btn btn-lg btn-primary mt-10 w-full sm:w-auto" href={whatsappUrl()} target="_blank" rel="nofollow noopener">
        Pedir Orçamento Pelo WhatsApp
      </a>
    </div>
  </div>
</section>
