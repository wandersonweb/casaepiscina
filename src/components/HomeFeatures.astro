---
import piscinaIcon from "../assets/icons/piscina-112.webp";
import qualidadeIcon from "../assets/icons/qualidade-112.webp";
import consertoIcon from "../assets/icons/conserto-112.webp";

const features = [
  {
    title: "Reforma",
    description: "Desfrute momentos de qualidade. Nossos reparos são impecáveis, garantindo lazer e relaxamento.",
    icon: piscinaIcon,
  },
  {
    title: "Qualidade",
    description: "Nossa missão é transformar piscinas com excelência, oferecendo serviços de reparo que superam expectativas.",
    icon: qualidadeIcon,
  },
  {
    title: "Conserto",
    description: "Confie em nossa expertise em conserto de piscina, onde a qualidade é nossa prioridade máxima.",
    icon: consertoIcon,
  },
];
---

<section class="section-surface pb-12 pt-10 md:pb-16 md:pt-12">
  <div class="container-site">
    <div class="grid gap-10 md:grid-cols-3 md:gap-8">
      {features.map((feature) => (
        <div class="card p-7 text-center">
          <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[#e8eef1]">
            <img src={feature.icon.src} alt="" width="64" height="64" class="h-16 w-16 object-contain" loading="lazy" decoding="async" />
          </div>
          <h2 class="mt-5 text-2xl font-black text-brand-ink">{feature.title}</h2>
          <p class="mx-auto mt-4 max-w-sm text-base leading-7 text-brand-muted">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
