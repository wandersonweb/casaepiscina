---
import { siteConfig } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonical: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, canonical, image = siteConfig.defaultImage, noindex = false } = Astro.props;
const absoluteImage = image.startsWith("http") ? image : new URL(image, siteConfig.url).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, follow" : "follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:image" content={absoluteImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
