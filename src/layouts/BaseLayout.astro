---
import "../styles/global.css";
import FloatingWhatsapp from "../components/FloatingWhatsapp.astro";
import Footer from "../components/Footer.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import Navbar from "../components/Navbar.astro";
import SEO from "../components/SEO.astro";
import { siteConfig } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  imagePreloads?: {
    href: string;
    media?: string;
    imagesrcset?: string;
    imagesizes?: string;
  }[];
}

const {
  title = "Casa e Piscina - Reforma de Piscina de Fibra em Belo Horizonte",
  description = "Especialistas em reforma, pintura e manutenção de piscina de fibra em Belo Horizonte e região metropolitana.",
  canonical = `${siteConfig.url}${Astro.url.pathname}`,
  image = siteConfig.defaultImage,
  noindex = false,
  imagePreloads = [],
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {imagePreloads.map((preload) => (
      <link
        rel="preload"
        as="image"
        href={preload.href}
        media={preload.media}
        imagesrcset={preload.imagesrcset}
        imagesizes={preload.imagesizes}
        fetchpriority="high"
      />
    ))}

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() {
        dataLayer.push(arguments);
      };

      function loadGoogleTag() {
        if (window.__googleTagLoaded) return;
        window.__googleTagLoaded = true;

        var script = document.createElement("script");
        script.async = true;
        script.src = "https://www.googletagmanager.com/gtag/js?id=G-PTPT96JJRX";
        document.head.appendChild(script);

        window.gtag("js", new Date());
        window.gtag("config", "G-PTPT96JJRX");
      }

      ["pointerdown", "keydown", "touchstart"].forEach(function (eventName) {
        window.addEventListener(eventName, loadGoogleTag, { once: true, passive: true });
      });

      window.addEventListener("load", function () {
        window.setTimeout(function () {
          var schedule = window.requestIdleCallback || function (callback) { return window.setTimeout(callback, 1); };
          schedule(loadGoogleTag, { timeout: 2000 });
        }, 12000);
      }, { once: true });
    </script>

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="mndvh5CQ-aRxyifvwZEhIsGmIIgB5bQYDISJMkr_Dz0" />

    <!-- Meta Pixel: cole o codigo do Facebook Pixel aqui quando precisar ativar. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo/favicon.svg" />
    <link rel="icon" type="image/png" href="/assets/logo/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/logo/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/assets/logo/apple-touch-icon-180x180.png" />
    <link rel="mask-icon" href="/assets/logo/logo-grande.svg" color="#0e2430" />
    <meta name="theme-color" content="#FFFFFF" />
    <SEO title={title} description={description} canonical={canonical} image={image} noindex={noindex} />
    <LocalBusinessSchema />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingWhatsapp />
  </body>
</html>
